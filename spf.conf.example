[admin]
bind = 127.0.0.1
port = 8081
token = change-me
tls = false
mtls = false
ca = /etc/ssl/certs/ca-certificates.crt
readonly = false
readonly_token = change-me-readonly
max_cmds_per_min = 240
auth_fail_threshold = 5
auth_lockout_sec = 300
idle_timeout_sec = 300
audit_log = /var/log/spf_audit.log
allowlist = 127.0.0.1

[security]
enabled = true
rate_per_ip = 120
rate_global = 5000
proxy_proto = false
ddos = true

[metrics]
enabled = true
port = 9100

[rule.web]
listen = 8080
lb = rr
backend = 127.0.0.1:9000:1
backend_tls = false
backend_tls_verify = false
# backend_tls_sni = backend.local
# backend_tls_ca = /etc/ssl/certs/ca-certificates.crt
# backend_tls_pin_sha256 = 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
rate = 104857600
